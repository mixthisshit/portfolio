# Один из двух ключей обязателен (для генератора резюме):

# OpenRouter — посредник, принимает российские карты.
# Получить: https://openrouter.ai/settings/keys
# Пополнить: https://openrouter.ai/credits
OPENROUTER_API_KEY=sk-or-v1-...

# Или Anthropic напрямую (Russian cards не принимаются):
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Опционально — переопределить модель:
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Supabase (для админки):
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...
